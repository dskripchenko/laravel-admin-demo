# Copy to .env.docker for `docker compose up`. Everything is optional.
APP_NAME="Laravel Admin Demo"
APP_URL=https://admin.example.com
# Leave empty: the container generates a key once and keeps it in /data.
APP_KEY=
# The proxy in front of the container; '*' trusts any (fine when the
# container's port is reachable only from the proxy).
TRUSTED_PROXIES=*

ADMIN_LOCALE=en
ADMIN_DEMO=true
ADMIN_DEMO_READONLY=true
ADMIN_NOTICE="Demo data resets every hour"
ADMIN_NOTICE_COUNTDOWN_LABEL="Next reset in"
DEMO_PASSWORD=demo
DEMO_RESET_CRON="0 * * * *"
