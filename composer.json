{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dskripchenko/laravel-admin-demo",
    "description": "Demonstration Laravel 12 host project with dskripchenko/laravel-admin and all eight sister packages wired up. Quick-start template and public showcase.",
    "type": "project",
    "keywords": [
        "laravel",
        "admin",
        "demo",
        "showcase",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-admin-demo",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-admin-demo/issues",
        "source": "https://github.com/dskripchenko/laravel-admin-demo"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/tinker": "^3.0",
        "dskripchenko/laravel-admin": "^1.7",
        "dskripchenko/laravel-admin-starter": "^1.3",
        "dskripchenko/laravel-admin-health": "^1.3",
        "dskripchenko/laravel-admin-jobs": "^1.3",
        "dskripchenko/laravel-admin-media": "^1.3",
        "dskripchenko/laravel-admin-pulse": "^1.3",
        "dskripchenko/laravel-admin-search": "^1.3",
        "dskripchenko/laravel-admin-quill": "^1.3",
        "dskripchenko/laravel-admin-tinymce": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force",
            "@php artisan db:seed --class=DemoSeeder --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
